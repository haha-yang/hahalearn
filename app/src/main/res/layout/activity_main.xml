<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 外层用 FrameLayout 替代 ConstraintLayout，供状态栏注入；内容仍由 ScrollView 承载 -->
    <FrameLayout
        android:id="@+id/cl_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <TextView
                    android:id="@+id/btn_skip_gps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityTraversalBefore="@+id/btn_skip_network"
                    android:gravity="center"
                    android:importantForAccessibility="auto"
                    android:text="GPS权限"
                    android:textSize="24sp"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btn_skip_remote_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="消息通知"
                    android:importantForAccessibility="yes"
                    android:text="消息通知 RemoteViews"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/btn_skip_gps" />

                <Button
                    android:id="@+id/btn_skip_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityTraversalBefore="@+id/btn_refresh"
                    android:contentDescription="网络"
                    android:importantForAccessibility="yes"
                    android:text="Network"
                    app:layout_constraintTop_toBottomOf="@+id/btn_skip_remote_view" />

                <Button
                    android:id="@+id/btn_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="auto"
                    android:text="刷新网络"
                    app:layout_constraintTop_toBottomOf="@+id/btn_skip_network" />

                <Button
                    android:id="@+id/btn_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="auto"
                    android:text="测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_refresh" />

                <Button
                    android:id="@+id/btn_test1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="auto"
                    android:text="测试1"
                    app:layout_constraintTop_toBottomOf="@+id/btn_test" />

                <Button
                    android:id="@+id/btn_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="权限"
                    app:layout_constraintTop_toBottomOf="@+id/btn_test1" />

                <Button
                    android:id="@+id/btn_dialog_fragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="弹窗"
                    app:layout_constraintTop_toBottomOf="@+id/btn_permission" />

                <Button
                    android:id="@+id/btn_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="动画"
                    app:layout_constraintTop_toBottomOf="@+id/btn_dialog_fragment" />

                <Button
                    android:id="@+id/btn_activity_scene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="Activity转场动画"
                    app:layout_constraintTop_toBottomOf="@+id/btn_animation" />

                <Button
                    android:id="@+id/btn_activity_coroutineScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="协程测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_scene" />

                <Button
                    android:id="@+id/btn_activity_custom_scene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="自定义Activity动画"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_coroutineScope" />

                <Button
                    android:id="@+id/btn_activity_custom_scene2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="自定义Activity动画2"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_custom_scene"
                    tools:layout_editor_absoluteX="0dp" />

                <Button
                    android:id="@+id/btn_activity_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="刷新RecyclerView"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_custom_scene2" />

                <ImageView
                    android:id="@+id/iv_scan_device"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:src="@drawable/net_ic_wlan"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_recyclerview" />

                <TextView
                    android:id="@+id/tv_span"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="你好你好你好你好你好你好你好你好你好你好你好你好你好你好你好你好"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_scan_device" />

                <ImageView
                    android:id="@+id/iv_success"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="40dp"
                    android:src="@drawable/config_command_ic_sucess_s"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <Button
                    android:id="@+id/btn_activity_waterfall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="瀑布流布局"
                    app:layout_constraintTop_toBottomOf="@+id/tv_span" />

                <Button
                    android:id="@+id/btn_activity_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="selector测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_waterfall" />

                <Button
                    android:id="@+id/btn_activity_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="媒体声音测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_selector" />

                <Button
                    android:id="@+id/btn_activity_speech_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="离线语音识别 / 实时字幕"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_volume" />

                <Button
                    android:id="@+id/btn_activity_slide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="左滑删除测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_speech_caption" />

                <Button
                    android:id="@+id/btn_activity_bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="蓝牙扫描"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_slide" />

                <Button
                    android:id="@+id/btn_activity_live_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="LiveData测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_bluetooth" />

                <Button
                    android:id="@+id/btn_activity_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="手写RecyclerView测试"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_live_data" />

                <!-- 容器保留在约束链中；ViewStub 首帧后再 inflate 自定义重控件 -->
                <FrameLayout
                    android:id="@+id/fl_cpv_container"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_live_data">

                    <ViewStub
                        android:id="@+id/stub_cpv"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:inflatedId="@+id/cpv"
                        android:layout="@layout/view_stub_circle_progress" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_activity_dynamic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="动态textview"
                    app:layout_constraintTop_toBottomOf="@+id/fl_cpv_container" />

                <Button
                    android:id="@+id/btn_activity_plugin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="跳转到插件"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_dynamic" />

                <Button
                    android:id="@+id/btn_ui_monitor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="UI监控"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_plugin" />

                <Button
                    android:id="@+id/btn_activity_mvi_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="MVI 框架"
                    app:layout_constraintTop_toBottomOf="@+id/btn_ui_monitor" />

                <Button
                    android:id="@+id/btn_activity_flutter_integration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="Flutter 框架"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_mvi_frame" />

                <Button
                    android:id="@+id/btn_activity_kmp_learn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="KMP / CMP 框架"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_flutter_integration" />

                <Button
                    android:id="@+id/btn_activity_binding_adapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="ViewBinding + BindingAdapter"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_kmp_learn" />

                <!--                <com.haha.main.pieChartView.CircleSectorView-->
                <!--                    android:id="@+id/csv"-->
                <!--                    android:visibility="gone"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="216dp"-->
                <!--                    android:layout_marginTop="10dp"-->
                <!--                    app:layout_constraintEnd_toEndOf="parent"-->
                <!--                    app:layout_constraintStart_toStartOf="parent"-->
                <!--                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_flutter_integration" />-->

                <!-- 容器保留在约束链中；PieChartView 首帧后再 inflate -->
                <FrameLayout
                    android:id="@+id/fl_pcv_container"
                    android:layout_width="216dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btn_activity_binding_adapter">

                    <ViewStub
                        android:id="@+id/stub_pcv"
                        android:layout_width="216dp"
                        android:layout_height="216dp"
                        android:inflatedId="@+id/pcv"
                        android:layout="@layout/view_stub_pie_chart" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </FrameLayout>
</layout>